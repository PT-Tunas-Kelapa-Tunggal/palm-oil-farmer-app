// Developer.xcconfig.example
// PalmOilFarmer
//
// Copy this template to "Developer.xcconfig" and fill in your individual Apple Developer account details:
//   cp Developer.xcconfig.example Developer.xcconfig
//
// NOTE: "Developer.xcconfig" is gitignored and will never be committed.

// Your 10-character Apple Developer Team ID (found at developer.apple.com -> Membership)
DEVELOPMENT_TEAM = 5VZU5CTZS2

// Your app bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.kee.PalmOilFarmer

// Your CloudKit container identifier
CLOUDKIT_CONTAINER_ID = iCloud.com.kee.PalmOilFarmer

// App display name
APP_DISPLAY_NAME = Palm Oil Farmer

// App Version and Build Number
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

