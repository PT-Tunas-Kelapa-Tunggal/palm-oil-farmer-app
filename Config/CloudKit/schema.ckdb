DEFINE SCHEMA
    CREATE ROLE KropsOperator;

    RECORD TYPE PlantationScanRequest (
        "___recordID" REFERENCE QUERYABLE,
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy" REFERENCE QUERYABLE,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        farmerName STRING,
        farmerPhone STRING,
        farmerAddress STRING,
        gardenID STRING QUERYABLE,
        gardenName STRING,
        locationName STRING,
        areaHectares DOUBLE,
        boundaryJSON STRING,
        agronomicJSON STRING,
        statusCode INT64 QUERYABLE,
        submittedAt TIMESTAMP,
        scheduledFor TIMESTAMP,
        inReviewAt TIMESTAMP,
        completedAt TIMESTAMP,
        operatorNotes STRING,
        resultJSON STRING,
        orthomosaicAsset ASSET,
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator",
        GRANT READ, WRITE TO KropsOperator
    );
