// Shared service defaults. Personal signing/settings belong in Services.local.xcconfig.
KROPS_DEVELOPMENT_TEAM =
KROPS_BUNDLE_IDENTIFIER = com.hata.Kropshata
KROPS_CLOUDKIT_CONTAINER = iCloud.com.hata.Kropshata
KROPS_REVIEW_TRANSPORT = native
// Used by Web Services only. Native CloudKit uses the signed profile's environment.
KROPS_WEB_ENVIRONMENT = development
KROPS_SERVICE_ENTITLEMENTS = Config/CloudKit/Native.entitlements

#include? "Services.local.xcconfig"
