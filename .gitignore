# Xcode settings specific to each developer.
xcuserdata/
Developer.xcconfig

# Local build products and macOS metadata.
.DS_Store
/build/
/DerivedData/
*.xcuserstate

# Swift package and Xcode build caches (keep Package.resolved tracked).
.build/
.swiftpm/
*.xcactivitylog
*.xcresult/
*.xcarchive/
*.dSYM/
*.dSYM.zip
*.ipa

# Local environment values; shared examples remain versioned.
.env
.env.*
!.env.example
!.env.*.example

# Temporary logs, editor files, and exported test artifacts.
*.log
*.swp
*.swo
*~
/artifacts/
/test-results/
/home-hifid-audit/
/profile-hifid-audit/

# Screenshots and reports from local development sessions.
/DesignReview/
/CODED_UI_UPDATE.md
/GLASS_SHEET_UPDATE.md
/OPTIMIZATION_REVIEW.md

# Personal notes kept only on a developer's machine.
/docs/ARCHITECTURE.md

# Editor and tooling folders.
.idea/
.vscode/
.claude/
CLAUDE.local.md

# Older Xcode and Instruments leftovers.
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
*.trace/
timeline.xctimeline
playground.xcworkspace
